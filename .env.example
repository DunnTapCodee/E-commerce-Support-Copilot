# =====================================================================
# AI Customer Support Copilot - Environment Configuration
# =====================================================================
# Copy this file to .env:
#   Windows: copy .env.example .env
#   Linux/Mac: cp .env.example .env
# Then enter your Gemini API key below.
# =====================================================================

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Name (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Module 1: generated deployment.env provides the calibrated threshold.
INTENT_MODEL_DIR=artifacts/models/intent
INTENT_ROUTING_MODE=router
# Legacy fallback until experiments/deploy.py writes the selected threshold.
INTENT_CONFIDENCE_THRESHOLD=0.60

# Intent-assignment evaluation with an LLM (OpenAI-compatible API)
LLM_API_BASE=https://api.xah.io/v1
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4o-mini
