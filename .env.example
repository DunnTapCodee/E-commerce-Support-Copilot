# =====================================================================
# AI Customer Support Copilot - Environment Configuration
# =====================================================================

# LLM Provider Configuration ('openai_compatible' or 'gemini')
LLM_PROVIDER=openai_compatible

# Ckey.vn / OpenAI-compatible API
OPENAI_API_KEY=your_openai_or_ckey_api_key_here
OPENAI_BASE_URL=https://api.xah.io/v1
OPENAI_MODEL=openai-gpt-oss-20b

# Google Gemini API Key (Fallback / Alternative)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Module 1: generated deployment.env provides the calibrated threshold.
INTENT_MODEL_DIR=artifacts/models/intent
INTENT_ROUTING_MODE=router
# Intent Service Backend Mode: 'llm', 'hybrid' (ML with LLM fallback), or 'ml' (legacy ML)
INTENT_BACKEND=llm

# Testing toggle: set to true to temporarily disable confidence threshold escalation
DISABLE_CONFIDENCE_GUARD=false

